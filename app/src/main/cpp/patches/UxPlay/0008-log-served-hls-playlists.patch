    Media Playlist, taken from the Master Playlist, with the uri prefix removed.  
 */ 
 
+#ifndef NDEBUG
+/* AIRCAP: log a served playlist line by line (debug only). playlist urls carry signed tokens in the query
+   *and* in path segments (/sig/.../expire/...), and queries contain commas, so for absolute urls keep only
+   scheme://host (the local proxy keeps its path, which is just the itag), and for relative ones drop
+   everything from '?' to the end of the token */
+static void aircap_log_playlist(raop_t *raop, const char *kind, const char *url, const char *text) {
+    char line[512];
+    const size_t cap = sizeof(line) - 1;
+    int n = 0;
+    const char *p = text;
+    while (p && *p && n < 80) {
+        const char *eol = strchr(p, '\n');
+        size_t len = eol ? (size_t) (eol - p) : strlen(p);
+        size_t o = 0, i = 0;
+        while (i < len && o < cap) {
+            if (i + 3 <= len && p[i] == ':' && p[i + 1] == '/' && p[i + 2] == '/') {
+                size_t j = i + 3, host = j;
+                while (j < len && p[j] != '/' && p[j] != '"' && p[j] != '?') j++;
+                int local = (j - host >= 9 && !strncmp(p + host, "localhost", 9)) ||
+                            (j - host >= 9 && !strncmp(p + host, "127.0.0.1", 9));
+                for (size_t k = i; k < j && o < cap; k++) line[o++] = p[k];
+                if (local) {
+                    while (j < len && p[j] != '"' && p[j] != '?' && o < cap) line[o++] = p[j++];
+                } else {
+                    for (const char *t = "/<path>"; *t && o < cap; t++) line[o++] = *t;
+                }
+                if (j < len && p[j] != '"') {
+                    if (p[j] == '?') for (const char *t = "?<redacted>"; *t && o < cap; t++) line[o++] = *t;
+                    while (j < len && p[j] != '"') j++;
+                }
+                i = j;
+                continue;
+            }
+            if (p[i] == '?') {
+                for (const char *t = "?<redacted>"; *t && o < cap; t++) line[o++] = *t;
+                while (i < len && p[i] != '"') i++;
+                continue;
+            }
+            line[o++] = p[i++];
+        }
+        line[o] = '\0';
+        logger_log(raop->logger, LOGGER_ERR, "AIRCAP HLS %s %s %d: %s", kind, url, n, line);
+        n++;
+        p = eol ? eol + 1 : NULL;
+    }
+}
+#endif
+
